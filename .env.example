# Copy to .env for local development, and set the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# Postgres connection string. The build no longer requires this to be present,
# but every database-backed route (/plan/[slug], /api/plan, /api/health) needs
# it at runtime.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Optional connection-pool tuning (defaults shown)
PGPOOL_MAX=3
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=10000
# Set to "disable" for local Postgres without TLS
PGSSLMODE=disable
